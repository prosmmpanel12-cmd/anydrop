<?xml version="1.0" encoding="utf-8"?>
<!-- Offer card for OfferManagerActivity's list — content matches doc 20
     §14's own mock:
       🔥 3 Samosa @ ₹50
       Used: 42 / 100
       Valid: 18 Aug – 25 Aug
       Status: ACTIVE
       [Edit] [Pause] [View]
     ic_fire/ic_delivery (this session's new drawables) stand in for the
     🔥/🚚 emoji, chosen by offer_type == "free_delivery" vs everything
     else — see OfferAdapter.bind(). "View" isn't a defined destination
     anywhere in this codebase yet (handover flagged this) — wired here
     to open the same edit dialog read-only rather than inventing a new
     detail screen; see OfferManagerActivity.showViewOfferDialog(). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp">

                <View
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_circle"
                    android:alpha="0.12"
                    android:backgroundTint="@color/anydrop_primary" />

                <ImageView
                    android:id="@+id/offerTypeIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    tools:src="@drawable/ic_fire" />

            </FrameLayout>

            <TextView
                android:id="@+id/offerTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="3 Samosa @ ₹50" />

            <TextView
                android:id="@+id/offerStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_badge_scheduled"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="ACTIVE" />

        </LinearLayout>

        <TextView
            android:id="@+id/offerUsageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="42dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            tools:text="Used: 42 / 100" />

        <TextView
            android:id="@+id/offerValidityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="42dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            tools:text="Valid: 18 Aug – 25 Aug" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOfferView"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offer_action_view"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOfferPauseResume"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/offer_action_pause"
                android:textSize="12sp"
                app:icon="@drawable/ic_pause"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOfferEdit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/offer_action_edit"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
