<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_management_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- §10 item 4 follow-up — drag-to-reorder toggle. Label swaps
             "⇅ Reorder" <-> "Done" (MenuFragment.toggleReorderMode()); see
             CategoryAdapter's class doc for why reorder mode shows the full
             stacked list (bypassing the tab strip / search filters below)
             rather than trying to combine three filter states at once. -->
        <TextView
            android:id="@+id/btnReorderCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_reorder_categories"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:padding="6dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btnAddCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_category"
            android:textColor="@color/anydrop_primary"
            android:textStyle="bold"
            android:padding="6dp" />
    </LinearLayout>

    <!-- §5 — "Drag ☰ to reorder" hint, shown only while reorder mode is
         active (replaces the search bar + tab strip below for the
         duration, see MenuFragment.enterReorderMode()). -->
    <TextView
        android:id="@+id/reorderHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:text="@string/menu_reorder_hint"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- §5 search bar — wired to menu-items-list.php's existing ?search=
         param via MenuFragment's debounced text watcher. Sits outside the
         SwipeRefreshLayout so it stays put while the list below refreshes.
         Hidden (with the tab strip below) while reorder mode is active. -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_pill"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@null"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/menu_search_hint"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />

        </LinearLayout>
    </LinearLayout>

    <!-- §5 — "Category tabs as a horizontal scroll strip... once a
         restaurant has 5+ categories." MenuFragment toggles this row's
         visibility based on the active-category count; empty/short
         category lists keep the plain stacked-card view with no tabs. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categoryTabsRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoriesRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="16dp"
                android:clipToPadding="false" />

            <!-- §9.2 skeleton state — shown only on the very first load
                 (categoriesRecycler empty going into a fetch), same
                 pattern as the Orders tab's per-section skeletons.
                 SwipeRefreshLayout's own small spinner covers the
                 pull-to-refresh case once data already exists (§9.1). -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:id="@+id/menuSkeletonScroll">

                <com.anydrop.restaurant.ui.common.ShimmerFrameLayout
                    android:id="@+id/menuSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/skeleton_menu_category_card" />
                        <include layout="@layout/skeleton_menu_category_card" />
                    </LinearLayout>
                </com.anydrop.restaurant.ui.common.ShimmerFrameLayout>
            </ScrollView>

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="32dp"
                android:gravity="center"
                android:text="@string/empty_categories"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
