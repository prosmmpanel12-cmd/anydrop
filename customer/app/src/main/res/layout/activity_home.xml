<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top brand bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_topbar_gradient"
        android:elevation="4dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_location"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/deliveryLocationText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/delivery_location_placeholder"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="8dp">

            <ImageView
                android:id="@+id/btnCart"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="2dp"
                android:src="@drawable/ic_cart"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/cartBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:minWidth="17dp"
                android:minHeight="17dp"
                android:gravity="center"
                android:paddingHorizontal="3dp"
                android:background="@drawable/bg_cart_badge"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:elevation="4dp" />

        </FrameLayout>

        <!-- Notification bell (Type 1, docs/Status.md 2026-08-20). Same
             FrameLayout+badge shape as btnCart above, one slot to its
             left so cart/profile positions don't shift. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="8dp">

            <ImageView
                android:id="@+id/btnNotifications"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="2dp"
                android:src="@drawable/ic_notification"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/notificationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:minWidth="17dp"
                android:minHeight="17dp"
                android:gravity="center"
                android:paddingHorizontal="3dp"
                android:background="@drawable/bg_cart_badge"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:elevation="4dp" />

        </FrameLayout>

        <ImageView
            android:id="@+id/btnProfile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_person"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Bug 6.1 — persistent Home GPS-off banner. Lives between topBar and
         searchBarContainer so it stays pinned (not inside swipeRefresh's
         scrolling content) — same "persistent top banner, not a bottom
         sheet" requirement as the bug spec. Visibility and text are both
         driven entirely from HomeActivity.updateGpsOffBanner(); this view
         starts gone and has no state of its own. The "unavailable" text
         variant deliberately reuses @string/service_area_unavailable_title
         (the same string serviceAreaUnavailable below already shows) rather
         than a new string, so this can never say something different from
         that screen for the same area — see updateGpsOffBanner() kdoc. -->
    <LinearLayout
        android:id="@+id/gpsOffBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_banner_info"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/gpsOffBannerIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_location"
            app:tint="@color/info_fg" />

        <TextView
            android:id="@+id/gpsOffBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="@color/info_fg"
            android:text="@string/gps_off_banner_soft" />

        <TextView
            android:id="@+id/btnGpsOffChangeAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:text="@string/change_address"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/info_fg"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Search + Veg toggle row (§1.3 redesign): pill-shaped search bar with a
         search icon on the left and a mic icon on the right (voice-search entry
         point, RecognizerIntent stub — see HomeActivity.launchVoiceSearch()).
         Only this row + topBar stay pinned; everything else scrolls (§1.4). -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_pill"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toBottomOf="@id/gpsOffBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/vegToggleContainer">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="@string/hint_search"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textSize="14sp"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/btnVoiceSearch"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:src="@drawable/ic_mic"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/voice_search" />

    </LinearLayout>

    <!-- Zomato-style "Veg only" toggle — ON by default. Restyled (§1.3) to sit
         flush against the shorter pill search bar; logic unchanged. -->
    <LinearLayout
        android:id="@+id/vegToggleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/searchBarContainer"
        app:layout_constraintBottom_toBottomOf="@id/searchBarContainer"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/vegToggleTrack"
            android:layout_width="42dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_veg_toggle_track_on"
            android:padding="3dp"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/vegToggleThumb"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_veg_toggle_thumb"
                android:elevation="2dp">

                <View
                    android:id="@+id/vegToggleDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="center"
                    android:background="@drawable/dot_veg_fill" />

            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/vegToggleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/veg_only"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/veg_green" />

    </LinearLayout>

    <!-- Category row: permanently pinned, always visible, right below the
         search bar — NOT part of the scrollable content at all, and no
         show/hide animation of its own. Earlier attempts tried to keep it
         inline and "pin" it as a side-effect of the banner collapsing
         (scrolled out of view before the animation caught up) or as a
         separate hidden clone that faded in mid-transition (visible seam/
         gap where the still-collapsing banner showed through underneath,
         and felt like an abrupt jump). Simplest fix that has neither
         problem: one instance, always shown, never animated. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categoryList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false"
        android:background="@color/background"
        app:layout_constraintTop_toBottomOf="@id/searchBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_food_category" />


    <!-- §1.4 scroll restructure: promo banner, section title, and the
         restaurant list are wrapped inside one NestedScrollView, itself
         wrapped in the SwipeRefreshLayout — same pattern already proven in
         activity_restaurant_detail.xml this session. topBar,
         searchBarContainer/vegToggleContainer, and categoryList stay pinned
         above this; collapsibleFilters (declared below, after this) floats
         as an OVERLAY on top of this instead of pushing it down — see that
         view's own comment for why. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/categoryList"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeNestedScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Reserves space equal to collapsibleFilters' expanded
                     height so that opaque overlay (declared later, drawn on
                     top of this whole scroll area) never covers the top of
                     the promo banner below. Without this, the banner's top
                     edge sat directly underneath the filter row whenever
                     filters were expanded (the normal/resting state), so
                     part of it was permanently hidden behind the overlay —
                     never a scroll issue, a static one. Height is set once
                     at runtime in HomeActivity.setupCollapsingHeader() to
                     exactly match collapsibleFiltersExpandedHeight; it does
                     NOT animate with the filter row's collapse/expand (that
                     would reintroduce the resize-feedback scroll bug this
                     screen already went through — see collapsibleFilters'
                     own comment below), it just reserves a constant gap. -->
                <View
                    android:id="@+id/filterOverlaySpacer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp" />

                <!-- Promo banner section — plain scrollable content now, no
                     collapse animation of its own. Scrolling down naturally
                     moves it out of view ("slides up and hides") and
                     scrolling back up naturally brings it back, since it's
                     simply the first item in the scrollable list — no
                     manual height animation needed (that was the earlier
                     source of the visible seam/gap and the abrupt-jump
                     feel, since it had to stay in sync with the pinned
                     category clone above). clipChildren stays true so nothing
                     can render outside its own bounds regardless. -->
                <LinearLayout
                    android:id="@+id/promoSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipToPadding="true"
                    android:clipChildren="true">

                <!-- Promo section (§2.2): ViewPager2 carousel reading getPromoBanners()
                     is preferred; falls back to the old single static banner
                     (promoBannerContainer, driven by splash-config home_promo_* fields)
                     when the banners list is empty or fails to load — those ids/children
                     are UNCHANGED so the existing showPromoBanner() fallback keeps
                     working exactly as before. Only one of the two is visible at a time. -->
                <LinearLayout
                    android:id="@+id/promoCarouselContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/promoCarousel"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:clipToPadding="false"
                        android:clipChildren="false" />

                    <!-- Dot indicators removed per request — kept in the layout
                         (unused, always gone) rather than deleted outright, in
                         case they're wanted back later; HomeActivity.kt no
                         longer attaches a TabLayoutMediator to it. -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/promoCarouselDots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:tabBackground="@drawable/tab_dot_selector"
                        app:tabGravity="center"
                        app:tabIndicatorHeight="0dp"
                        app:tabPaddingStart="4dp"
                        app:tabPaddingEnd="4dp"
                        app:tabMinWidth="8dp"
                        app:tabMaxWidth="8dp"
                        app:tabRippleColor="@null" />

                </LinearLayout>

                <!-- Promo banner — driven entirely by the backend (splash-config API),
                     e.g. "Flash Sale" style highlight. Hidden if home_promo_enabled=0,
                     or if the carousel above has real banners to show instead. -->
                <FrameLayout
                    android:id="@+id/promoBannerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_card_rounded"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/promoBannerImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_card_rounded" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#59000000" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:layout_margin="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/promoBannerTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/promoBannerSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/white"
                            android:alpha="0.95"
                            android:textSize="13sp" />

                    </LinearLayout>

                </FrameLayout>

                </LinearLayout>
                <!-- /promoSection -->

                <!-- "Popular dishes near you" (§2.4) — horizontal-scroll cross-
                     restaurant dish row, hidden entirely if the endpoint returns
                     nothing (never shows an empty section). Sits above the
                     restaurant list, below the filter chips. -->
                <TextView
                    android:id="@+id/popularItemsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/popular_dishes_near_you"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/popularItemsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:paddingEnd="12dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:listitem="@layout/item_popular_dish"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/sectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/restaurants_near_you"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <!-- I3 (docs/features.md Phase I) — Search filters pill.
                         Only shown while in search-results mode (see
                         HomeActivity.runSearchOrReload); Home's own
                         collapsibleFilters row covers this outside search. -->
                    <TextView
                        android:id="@+id/btnSearchFilters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="@string/search_filters_pill_label"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_chip_unselected"
                        android:drawableStart="@drawable/ic_filter"
                        android:drawablePadding="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/restaurantList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />

                <!-- Explore More tile row (§2.3) — Offers / Top 10 real,
                     Food on train / Collections visually-present "Coming
                     soon" placeholders per the spec's scope decision. -->
                <TextView
                    android:id="@+id/exploreMoreTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/explore_more"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/exploreTileList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="24dp"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_explore_tile" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Filter chips: All / Near & Fast / Under ₹200 / Pure Veg / Open Now /
         Rating. Positioned at the SAME top anchor as swipeRefresh
         (categoryList's bottom) but declared AFTER it, so it draws as an
         OPAQUE OVERLAY on top of the scrollable content's top edge rather
         than pushing swipeRefresh down. This is deliberate: an earlier
         version had swipeRefresh's top constrained to collapsibleFilters'
         bottom, so collapsing/expanding this row resized swipeRefresh (and
         therefore homeNestedScroll) on every animation frame — and a
         NestedScrollView resizing mid-scroll can silently clamp/adjust its
         own scrollY, which fired spurious scroll callbacks that immediately
         re-triggered the expand right after a collapse, i.e. the
         "hides for a moment then snaps back" flicker. Overlaying instead of
         resizing means collapsing/expanding this never changes
         homeNestedScroll's size at all, so it can't generate those spurious
         events — collapse and expand now only ever run once per real
         scroll gesture, and only the ValueAnimator's own smooth height
         steps produce visible movement. android:background matches the
         screen background so it fully covers whatever's scrolled underneath
         while expanded; collapsing simply reveals that content instead of
         resizing anything. -->
    <LinearLayout
        android:id="@+id/collapsibleFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background"
        android:elevation="3dp"
        android:clipToPadding="true"
        android:clipChildren="true"
        app:layout_constraintTop_toBottomOf="@id/categoryList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <HorizontalScrollView
            android:id="@+id/filterScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/filter_all"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_selected" />

                <TextView
                    android:id="@+id/chipNearFast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/filter_near_fast"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_unselected" />

                <TextView
                    android:id="@+id/chipUnder200"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/filter_under_200"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_unselected" />

                <TextView
                    android:id="@+id/chipPureVeg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/filter_pure_veg"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_unselected" />

                <TextView
                    android:id="@+id/chipOpenNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/filter_open_now"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_unselected" />

                <TextView
                    android:id="@+id/chipRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/filter_rating"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_unselected" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
    <!-- /collapsibleFilters -->

    <!-- §2.4 (updated part 19 per live screenshot 3) — "Back to top" pill.
         Floats over the restaurant list, centered — matches the reference
         screenshot exactly (pill shape, "↑ Back to top" icon+text, not the
         plain circular icon-only mini FAB part 18 originally built).
         Visibility is driven by HomeActivity.kt's isFarFromTop, NOT by
         collapsibleFilters' own state (that 1:1 mirroring was part 18's
         bug — screenshot 3 shows filters and this pill visible at the same
         time). GONE by default; shown/hidden with a slide (translationY)
         animation via animateBackToTop(), not a visibility toggle alone. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnBackToTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="34dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textSize="12sp"
        app:iconSize="14dp"
        app:iconPadding="4dp"
        android:text="@string/back_to_top"
        app:icon="@drawable/ic_arrow_up"
        app:iconTint="@color/white"
        android:textColor="@color/white"
        android:contentDescription="@string/cd_back_to_top"
        android:visibility="gone"
        app:backgroundTint="@color/anydrop_primary"
        app:elevation="6dp"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/collapsibleFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- §2.3 — "not available in your area yet" full-screen state. Shown
         only when browsing the default (unfiltered/unsearched) Home feed
         and the plain restaurants call comes back with zero results — a
         genuinely unserved-area signal, not just an over-filtered search.
         Replaces swipeRefresh's content entirely (not layered inside the
         emptyState LinearLayout above) since this needs its own retry
         button and different copy from a plain "no results" message. -->
    <LinearLayout
        android:id="@+id/serviceAreaUnavailable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        android:background="@color/background"
        app:layout_constraintTop_toBottomOf="@id/searchBarContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_location"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/serviceAreaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/service_area_unavailable_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <TextView
            android:id="@+id/serviceAreaMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/service_area_unavailable_message"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnServiceAreaChangeLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/service_area_change_location"
            android:textSize="13sp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnServiceAreaRetry"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/service_area_retry"
            android:textSize="13sp"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchBarContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_restaurant"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/empty_restaurants"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
