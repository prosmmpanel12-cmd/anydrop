<?xml version="1.0" encoding="utf-8"?>
<!-- Insights tab skeleton (docs/restorent/19 §9.2: "4 skeleton stat
     chip boxes in a row + one gray rectangle where the bar chart will
     render"). Wrapped in a ShimmerFrameLayout by the fragment, same as
     every other tab's skeleton. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <!-- 4 stat chips in a 2x2 grid (mirrors the real stat cards below) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_skeleton_bar" />

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_skeleton_bar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_skeleton_bar" />

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_skeleton_bar" />
    </LinearLayout>

    <!-- Chart-shaped gray rectangle -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_skeleton_bar" />

</LinearLayout>
