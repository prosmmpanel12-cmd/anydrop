<?xml version="1.0" encoding="utf-8"?>
<!--
  features.md §I4 — "Schedule for later" slot picker, opened from the
  restaurant-detail ETA row (see RestaurantDetailActivity.detailEtaRow) and
  re-opened from CheckoutActivity's delivery-time row to change the slot.
  Same drag-handle/title/close-icon shell as fragment_restaurant_offers.xml.
  Same-day only, per app owner's explicit scope call — this sheet never
  shows a date picker, just "Deliver Now" + today's remaining time slots.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_selected" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_sheet_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/btnCloseSchedule"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />

    </LinearLayout>

    <TextView
        android:id="@+id/scheduleSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:text="@string/schedule_sheet_subtitle" />

    <!-- "Deliver Now" is always the first, pinned option — a plain row in
         the same list rather than a separate view, so the selected-state
         styling (checkmark, bold, primary-colored text) is one shared code
         path with the generated time-slot rows below it. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp">

        <LinearLayout
            android:id="@+id/scheduleSlotList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp" />

    </androidx.core.widget.NestedScrollView>

    <!-- Shown instead of scheduleSlotList when the restaurant has no open
         slots left today (e.g. it's already past closing_time minus the
         minimum lead time) — same "explain why, don't just show nothing"
         principle as the below-minimum-order banner on checkout. -->
    <TextView
        android:id="@+id/scheduleEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="20dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:text="@string/schedule_no_slots_today"
        android:visibility="gone" />

</LinearLayout>
