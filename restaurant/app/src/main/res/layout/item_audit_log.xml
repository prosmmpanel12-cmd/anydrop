<?xml version="1.0" encoding="utf-8"?>
<!--
    Migration 64 (Staff Audit Trail, PENDING.md §7's last checkbox).
    StaffAuditLogActivity's RecyclerView row — one per audit_logs
    entry. Same title+subtitle card shape as item_closure.xml/
    item_staff.xml, but read-only — no edit/delete icons, since an
    audit trail is a history, not something an owner mutates.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_clock"
            app:tint="@color/anydrop_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/auditActionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="Priya Sharma added as Kitchen" />

            <TextView
                android:id="@+id/auditByText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                tools:text="By you (Owner)" />

            <TextView
                android:id="@+id/auditTimeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:alpha="0.7"
                tools:text="30 Aug 2026, 4:12 PM" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
