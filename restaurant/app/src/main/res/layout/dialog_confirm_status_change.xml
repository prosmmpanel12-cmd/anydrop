<?xml version="1.0" encoding="utf-8"?>
<!-- Status-change confirm dialog (2026-09-11, plan doc 127 §2) — modeled
     directly on dialog_logout_confirm.xml's structure (illustration,
     title, message, side-by-side Cancel/Confirm buttons), reused for
     both "Mark Preparing" and "Mark Ready" via StatusChangeConfirmDialog,
     rather than two near-identical dialogs. Title/message are set
     programmatically per transition; the illustration reuses an
     existing drawable (no status-specific art commissioned for this). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/anydrop_primary"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/statusChangeDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center" />

    <TextView
        android:id="@+id/statusChangeDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusChangeDialogCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusChangeDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/anydrop_primary"
            android:text="@string/btn_confirm" />

    </LinearLayout>

</LinearLayout>
