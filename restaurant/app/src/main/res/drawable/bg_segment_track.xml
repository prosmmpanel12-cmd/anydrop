<?xml version="1.0" encoding="utf-8"?>
<!-- Track for the Today / This Week / This Month segmented range control
     (Insights screen). Replaces the old MaterialButtonToggleGroup +
     ToggleButton.Pill combo, which rendered inconsistently: the group's
     automatic corner-squaring on inner buttons fought with the style's
     own uniform 20dp cornerRadius, so only the first ("Today") button
     ever looked like a proper pill while the other two rendered as
     plain bordered rectangles. This is a single rounded-rect track with
     three equally-weighted segments drawn on top (see bg_segment_item.xml),
     so all three segments always share one consistent, evenly-rounded
     shape regardless of position. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/outline" />
    <corners android:radius="22dp" />
</shape>
