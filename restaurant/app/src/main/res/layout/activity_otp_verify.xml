<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-login ink pass (2026-08-16, docs/restorent/19 §10 item 7): btnBack
     moved into its own ink header bar (same background/tint pattern as
     activity_order_detail.xml's header) instead of floating unstyled on
     the plain background — gives this screen the same "consistent header
     treatment" as the app's other back-button screens. otpTitle/
     otpSubtitle keep their IDs/positions unchanged (OtpVerifyActivity.kt
     sets otpSubtitle's text at runtime), just shifted into the padded
     body below the header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/anydrop_ink">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_on_ink"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

    <TextView
        android:id="@+id/otpTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/otp_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/otpSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:id="@+id/otpBoxRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <EditText
            android:id="@+id/otpDigit1"
            style="@style/OtpDigitBox" />

        <EditText
            android:id="@+id/otpDigit2"
            style="@style/OtpDigitBox" />

        <EditText
            android:id="@+id/otpDigit3"
            style="@style/OtpDigitBox" />

        <EditText
            android:id="@+id/otpDigit4"
            style="@style/OtpDigitBox" />

        <EditText
            android:id="@+id/otpDigit5"
            style="@style/OtpDigitBox" />

        <EditText
            android:id="@+id/otpDigit6"
            style="@style/OtpDigitBox" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/anydrop_primary"
        android:text="@string/btn_verify"
        app:cornerRadius="12dp" />

    <ProgressBar
        android:id="@+id/otpProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtResend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/anydrop_primary"
        android:textStyle="bold"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    </LinearLayout>
</LinearLayout>
