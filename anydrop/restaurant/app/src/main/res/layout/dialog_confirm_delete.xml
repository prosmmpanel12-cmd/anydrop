<?xml version="1.0" encoding="utf-8"?>
<!-- Illustrated delete-confirmation dialog (2026-08-19 illustration
     retrofit — matches the app owner's reference mockup's "Confirm
     Delete Dialog" panel). Replaces confirmDeleteItem()/
     confirmDeleteCategory()'s previous plain
     MaterialAlertDialogBuilder(.setMessage(...)) text dialog in
     MenuFragment.kt. Shared by both flows — title/message TextViews are
     set from Kotlin per call site (item vs. category wording), rather
     than being two near-identical layout files.

     Kept as a MaterialAlertDialogBuilder(.setView(...)) centered dialog,
     not a BottomSheetDialog — doc 22's confirmed split puts delete
     confirmations in the "simple, stays centered" bucket, only
     add-coupon/add-menu-item moved to bottom sheets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_icon_circle"
        android:backgroundTint="@color/outline">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/illus_confirm_delete"
            android:contentDescription="@null" />

    </FrameLayout>

    <TextView
        android:id="@+id/deleteDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/anydrop_primary"
        android:gravity="center"
        tools:text="Delete this item?" />

    <TextView
        android:id="@+id/deleteDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        tools:text="This action cannot be undone." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteDialogCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteDialogDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/anydrop_primary"
            android:text="@string/btn_delete" />

    </LinearLayout>

</LinearLayout>
