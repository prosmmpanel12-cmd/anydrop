<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="130dp">

            <com.anydrop.food.ui.common.DishPhotoCarouselView
                android:id="@+id/restaurantCarousel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Offer badge, e.g. "50% OFF select items" — bottom-end corner
                 over the cover image (moved here from top-start per user
                 request, 2026-08-09, to match the same bottom-right corner
                 convention as the menu-item/popular-dish discount badges
                 from features.md §4). Hidden when offer_badge_text is null. -->
            <TextView
                android:id="@+id/restaurantOfferBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_discount_badge_corner"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="50% OFF select items"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/restaurantBookmark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:padding="6dp"
                android:background="@drawable/bg_bookmark_circle"
                android:src="@drawable/ic_bookmark_outline"
                app:tint="@color/text_primary" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/restaurantName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Spice Garden" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/rating_gold" />

                <TextView
                    android:id="@+id/restaurantRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <TextView
                android:id="@+id/restaurantCuisines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- features.md §5 — cross-fades between "{eta} mins | {distance} km"
                     and a highlighted "Near & Fast" row when the restaurant qualifies.
                     Applies regardless of open/closed status (2026-08-09) — see
                     RotatingEtaView's kdoc. -->
                <com.anydrop.food.ui.common.RotatingEtaView
                    android:id="@+id/restaurantEta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:measureAllChildren="false" />

                <TextView
                    android:id="@+id/restaurantStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Tag chips row — "Near & Fast", "Pure Veg restaurant", "Extra 10% OFF" etc,
                 driven by restaurant.tags from the backend (restaurant_tag_map). -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/restaurantTagsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="false" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
