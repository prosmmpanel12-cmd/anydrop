<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Shared top bar (docs/restorent/19 §3): restaurant name + big
         OPEN/CLOSED pill, pinned above the bottom nav on every tab.
         Moved here from OrdersFragment as part of the Orders tab
         redesign (§10 item 3) — was a small SwitchMaterial inside
         OrdersFragment's own top section before this.

         Reverted 2026-08-16 (§8.1.1) back to plain white (@color/surface)
         with @color/text_primary text — app owner preferred the original
         orange+white look to the ink-chrome refresh after real-device
         testing. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/restaurantNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Phase 4 redesign (was a single clickable dot+text pill,
             plain LinearLayout, colored only via manually-swapped
             drawables in code). Now a two-segment pill toggle matching
             item_coupon_manage_row.xml's is_active toggle language —
             tap the other segment to switch; MainActivity keeps the
             tap-to-confirm-before-closing behavior on top of this. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/statusToggleGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusOpen"
                style="@style/ToggleButton.Pill.StatusOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restaurant_open_label"
                app:icon="@drawable/ic_check_circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusClosed"
                style="@style/ToggleButton.Pill.StatusClosed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restaurant_closed_label"
                app:icon="@drawable/ic_error" />

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Reverted 2026-08-16 (§8.1.1) back to plain white (@color/surface)
         background, matching the top bar's revert above. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
