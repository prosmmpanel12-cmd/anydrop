<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AnydropRestaurant" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/anydrop_primary</item>
        <item name="colorPrimaryVariant">@color/anydrop_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/anydrop_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- Reverted 2026-08-16 (§8.1.1) back to the flat orange status bar,
             matching activity_main.xml's top-bar revert. -->
        <item name="android:statusBarColor">@color/anydrop_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Pill-shaped ON/OFF toggle (doc 22 item 4, app-owner ask
         2026-08-18: "make the toggle attractive, your call on style").
         Used as the two children of a MaterialButtonToggleGroup (single
         selection) — item_coupon_manage_row.xml's is_active toggle and
         dialog_add_coupon.xml's is_public toggle both reuse this same
         style so the whole coupon screen has one consistent toggle
         language rather than a different control per flag. Selected/
         unselected coloring comes from MaterialButtonToggleGroup's own
         checked-state handling against colorPrimary — no manual
         state-list drawable needed. -->
    <style name="ToggleButton.Pill" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/anydrop_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">16dp</item>
    </style>

    <!-- ToggleButton.Pill.StatusOpen/StatusClosed (Phase 4, top-bar
         segmented toggle) removed 2026-08-19: superseded by the
         toggle-standardization pass — the top-bar status control is a
         plain SwitchMaterial now (activity_main.xml's statusSwitch),
         styled via switch_track_color.xml like every other on/off switch
         in the app, not a bespoke segmented-button style. -->

    <!-- Filled-pill switch restyle (2026-08-19, app owner's reference
         mockup: solid green/red rounded track, big white thumb with a
         soft shadow — replaces the default thin-line Material track/
         small-thumb look everywhere in this app). Set android:track and
         android:thumb here directly rather than app:trackTint/
         app:thumbTint, since tinting the stock track drawable can't
         reproduce a solid filled pill — the shape itself has to change.
         Every SwitchMaterial in the app should use this one style so
         they all look identical; only the track selector differs for
         the one inverted switch (switchTempClosed). -->
    <style name="ToggleSwitch.Filled" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="track">@drawable/toggle_track_selector</item>
        <item name="android:track">@drawable/toggle_track_selector</item>
        <item name="android:thumb">@drawable/bg_toggle_thumb</item>
        <item name="showText">false</item>
        <item name="android:textOn">@null</item>
        <item name="android:textOff">@null</item>
    </style>

    <!-- Inverted counterpart for switchTempClosed only — same thumb,
         track selector direction reversed (see
         toggle_track_selector_inverted.xml). -->
    <style name="ToggleSwitch.Filled.Inverted">
        <item name="track">@drawable/toggle_track_selector_inverted</item>
        <item name="android:track">@drawable/toggle_track_selector_inverted</item>
    </style>

    <!-- Single-digit OTP input box (ui/signup/OtpVerifyActivity) — six of these
         in a row, auto-advancing on input, same visual language as
         bg_card_rounded used everywhere else in this app for input fields. -->
    <style name="OtpDigitBox">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_card_rounded</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:cursorVisible">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
</resources>
