<?xml version="1.0" encoding="utf-8"?>
<!--
    Deep-plan §21, migration 74 — one row in RequestPayoutActivity's
    history list. Modeled directly on the customer app's
    item_withdrawal.xml (surface card, two-line text block + trailing
    status pill); status shown as a colored label same as that screen,
    since a payout only ever moves money one direction (out).

    Uses MaterialCardView instead of the customer app's plain CardView
    since this app's theme (Widget.AnydropRider.Card) already styles it
    with the right outline/corner radius by default.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/payoutAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="₹250.00" />

            <TextView
                android:id="@+id/payoutMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                tools:text="Bank transfer" />

            <TextView
                android:id="@+id/payoutDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                tools:text="12 Jul, 8:42 PM" />

            <TextView
                android:id="@+id/payoutRejectReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/error_fg"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Reason: Invalid account details" />

        </LinearLayout>

        <TextView
            android:id="@+id/payoutStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_status_pill"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:textColor="@color/status_pending_fg"
            tools:text="Requested" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
