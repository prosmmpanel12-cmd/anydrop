<?xml version="1.0" encoding="utf-8"?>
<!-- Shown inside a MaterialAlertDialogBuilder from
     MenuFragment.showCategoryIconPickerDialog(). Phase 1 of the
     2026-08-19 UI/UX overhaul: what used to be a single bundled-icon
     grid is now 3 tabs —
       1. Bundled  — CategoryIcons.ALL via CategoryIconPickerAdapter (the
          original, zero-network grid, unchanged).
       2. Icons    — live search against Iconify (free, no key) via
          CategoryIconSearchAdapter.
       3. Photos   — live search against Openverse (free, openly-licensed
          photos, no key) via CategoryPhotoSearchAdapter.
     categoryIconGrid's adapter is swapped by MenuFragment depending on
     the selected tab; searchInputLayout is only visible for the two
     search tabs. Picking any result in any tab ends by staging a local
     image (bundled: a drawable resource key; search tabs: a downloaded/
     rasterized local file Uri) and dismissing this dialog — see
     MenuFragment's onIconSearchResultPicked()/onPhotoSearchResultPicked(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="4dp"
    tools:context="com.anydrop.restaurant.ui.menu.MenuFragment">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/iconPickerTabGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabBundled"
            style="@style/ToggleButton.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_picker_tab_bundled"
            android:checked="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabIcons"
            style="@style/ToggleButton.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_picker_tab_icons" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabPhotos"
            style="@style/ToggleButton.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_picker_tab_photos" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:startIconDrawable="@drawable/ic_search"
        app:endIconMode="clear_text"
        tools:visibility="visible">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/iconSearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/icon_picker_search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryIconGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="8dp"
            android:clipToPadding="false" />

        <ProgressBar
            android:id="@+id/searchProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/anydrop_primary"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/searchEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:text="@string/icon_picker_search_prompt"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</LinearLayout>
