<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-08-31: the new ANYDROP logo PNG (mipmap/ic_launcher*) has a
     black rounded-square background baked into the image itself. Now
     that the splash screen and login/signup hero headers are also solid
     black (monochrome theme), the logo was rendering almost invisible —
     black-on-black. This white circle sits behind the logo on those
     screens so it has contrast again. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/white" />
</shape>
