<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Photo picker (NEXT_SESSION_PROMPT.md item 4) — same staged-upload
         pattern as EditProfileActivity's logoPickerRow / the menu-item
         dialog's itemPhotoPickerRow above. categoryPhotoPreview now doubles
         as the bundled-icon preview too (doc 22 item 1) — whichever of a
         picked photo Uri / picked icon key is most recent wins, they're
         mutually exclusive (MenuFragment.showCategoryDialog()'s
         pickedCategoryIconKey / pickedCategoryPhotoUri handling). -->
    <LinearLayout
        android:id="@+id/categoryPhotoPickerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/stat_chip_bg"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/categoryPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_food_placeholder"
                android:padding="20dp"
                app:tint="@color/text_secondary"
                android:contentDescription="@null" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/categoryPhotoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_add_photo"
            android:textColor="@color/anydrop_primary"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- doc 22 item 1 — "choose from bundled icons" alternative to an
         upload, sitting right below the photo picker rather than replacing
         it (upload stays available for restaurants who want a real dish/
         category photo). Opens showCategoryIconPickerDialog(); tapping an
         icon there clears any picked photo and vice versa. -->
    <TextView
        android:id="@+id/btnChooseCategoryIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:padding="6dp"
        android:text="@string/btn_choose_icon"
        android:textColor="@color/anydrop_primary_dark"
        android:textStyle="bold"
        android:textSize="13sp"
        android:background="?attr/selectableItemBackground" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:startIconDrawable="@drawable/ic_tag">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_category_name"
            android:inputType="textCapWords"
            android:maxLength="100" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
