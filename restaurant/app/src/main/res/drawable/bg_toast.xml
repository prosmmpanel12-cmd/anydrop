<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-08-31 kit-matching toast (ref: "70. TOAST MESSAGES" panel — a
     flat white/black rounded card with a colored icon, not the plain OS
     Toast bubble). Corner radius matches bg_card_rounded.xml so it reads
     as the same design language as every other card in the app. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface" />
    <stroke android:width="1dp" android:color="@color/outline" />
    <corners android:radius="14dp" />
</shape>
