<?xml version="1.0" encoding="utf-8"?>
<!-- Custom SwitchMaterial track (2026-08-19 toggle redesign, resized
     2026-08-20 per a second app-owner reference — a noticeably more
     compact pill than the first pass' 52x30dp, still fully-filled and
     colored orange when ON / light grey when OFF, not the thin Material
     line-track or the old green/red scheme. Paired with
     switch_thumb_pill.xml (now a small black circle, was white) via
     app:track/app:thumb on Widget.AnydropRestaurant.Switch — every
     SwitchMaterial in the app uses that one style, so this single pair
     of drawables drives all of them. Fixed intrinsic size (38dp x 20dp)
     so the pill always renders at the same size regardless of where
     it's used. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/anydrop_primary" />
            <corners android:radius="10dp" />
            <size
                android:width="38dp"
                android:height="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/switch_track_off" />
            <corners android:radius="10dp" />
            <size
                android:width="38dp"
                android:height="20dp" />
        </shape>
    </item>
</selector>
