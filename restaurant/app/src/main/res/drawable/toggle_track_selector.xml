<?xml version="1.0" encoding="utf-8"?>
<!-- Picks the green (ON) vs red (OFF) filled-pill track by checked state.
     Set as android:track on SwitchMaterial via style_toggle_switch —
     replaces the old app:trackTint="@color/switch_track_color" approach,
     which could only tint the default thin-line track shape, not
     reproduce the reference mockup's solid filled pill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_toggle_track_on" android:state_checked="true" />
    <item android:drawable="@drawable/bg_toggle_track_off" />
</selector>
