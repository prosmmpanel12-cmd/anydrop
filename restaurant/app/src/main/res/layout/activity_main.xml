<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Shared top bar (docs/restorent/19 §3): restaurant name + big
         OPEN/CLOSED pill, pinned above the bottom nav on every tab.
         Moved here from OrdersFragment as part of the Orders tab
         redesign (§10 item 3) — was a small SwitchMaterial inside
         OrdersFragment's own top section before this.

         2026-08-16 palette refresh (§8.1): background swapped from plain
         white (@color/surface) to the new @color/anydrop_ink dark navy —
         restaurantNameText recolored to @color/text_on_ink (white) to
         match. The OPEN/CLOSED pill's own light background
         (bg_pill_open/bg_pill_closed) is untouched and still reads fine
         as a light badge sitting on the dark bar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/anydrop_ink"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/restaurantNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_ink"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/openClosedPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_open"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/openClosedDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot_green" />

            <TextView
                android:id="@+id/openClosedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/veg_green" />
        </LinearLayout>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 2026-08-16 palette refresh (§8.1): background swapped to
         @color/anydrop_ink to match the top bar, so the nav chrome reads
         as one continuous dark "frame" around the white content area
         instead of two separate white bars top and bottom. Item tint
         swapped to bottom_nav_item_color's dark-surface variant (below). -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/anydrop_ink"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
