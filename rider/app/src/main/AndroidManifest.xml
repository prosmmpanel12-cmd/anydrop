<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Service-area GPS auto-detect on the signup form (doc 79 —
         "live location fetch AND dropdown, both, dropdown wins if both
         given"). Same permission pair the restaurant/customer apps use
         for their own location pickers. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AnydropRider"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <!-- usesCleartextTraffic: needed for a local dev HTTP backend during
             development, same as the customer/restaurant apps (see
             network/ApiClient.kt). -->

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AnydropRider">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rider auth is email-OTP-only (passwordless) — this screen
             collects just the email and requests an OTP; OtpVerifyActivity
             does double duty as login (existing rider) and step 2 of
             signup (new email), per rider-verify-otp.php's own contract. -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.login.OtpVerifyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.signup.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Shown right after signup (rider-signup.php issues a token
             immediately, per its own kdoc) and also whenever a returning
             rider logs in while still status=pending/rejected/suspended.
             No dashboard/MainActivity exists yet — Phase 2 (core delivery
             flow) is what actually needs one, once an admin approves a
             rider via backend/admin/riders.php. -->
        <activity
            android:name=".ui.pending.ApplicationStatusActivity"
            android:exported="false" />

    </application>

</manifest>
