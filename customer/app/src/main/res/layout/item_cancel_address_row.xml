<?xml version="1.0" encoding="utf-8"?>
<!--
  Plan doc 127 §4 / 128 — cancel-retention flow's "change delivery
  address" picker, inside CancelOrderOptionsBottomSheet. Deliberately a
  much lighter row than item_address_card.xml (Address Book's card,
  which has Edit/Delete/Set Default actions) — this row only ever needs
  to be tapped to select, never edited from here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cancelAddressRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/cancelAddressRowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/anydrop_primary"
                tools:text="Home" />

            <TextView
                android:id="@+id/cancelAddressRowCurrentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/cancel_address_current_badge"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/cancelAddressRowFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="221B, 4th Floor, Baker Street, Near Metro Station" />
    </LinearLayout>

    <ImageView
        android:id="@+id/cancelAddressRowCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/anydrop_primary"
        android:visibility="gone" />

</LinearLayout>
