<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/addressLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/anydrop_primary"
                tools:text="Home" />

            <TextView
                android:id="@+id/addressDefaultBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/label_default"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/addressFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            tools:text="A-101, Sunrise Apartments, MG Road, Bengaluru" />

        <TextView
            android:id="@+id/addressReceiver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            tools:text="Receiver: Rahul Sharma, 9876543210" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <!-- Bug 6.2 — "Set as default" tap target. Own row-level click
                 target (not the card's existing tap-to-activate behavior,
                 which is a different action — see AddressAdapter kdoc for
                 why those two must stay separate). Hidden on whichever
                 address is already the default, since there's nothing
                 useful to tap there. Weighted to sit at the row's start so
                 Edit/Delete stay anchored to the end like before. -->
            <TextView
                android:id="@+id/btnSetDefaultAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="6dp"
                android:text="@string/btn_set_default"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/btnEditAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/btn_edit"
                android:textSize="12sp"
                android:textColor="@color/anydrop_primary"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/btnDeleteAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/btn_delete"
                android:textSize="12sp"
                android:textColor="@color/error_fg"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
