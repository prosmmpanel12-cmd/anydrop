<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="22dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="10dp">

        <View
            android:id="@+id/vegBadge"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_badge_veg" />

        <TextView
            android:id="@+id/itemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/itemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/itemDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- "Highly reordered" pill (features.md §3) — visible only when
             item.isBestseller is true, bound in MenuAdapter.ItemVH.bind(). -->
        <TextView
            android:id="@+id/itemHighlyReordered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_highly_reordered"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="@string/highly_reordered"
            android:textColor="@color/success_fg"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/itemImage"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_card_rounded" />

        <!-- Discount badge, bottom-end corner of the image (features.md §4).
             Visible only when item.discountPercent > 0, bound in
             MenuAdapter.ItemVH.bind(). -->
        <TextView
            android:id="@+id/itemDiscountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_discount_badge_corner"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="20% OFF"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/itemBookmark"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:padding="5dp"
            android:background="@drawable/bg_bookmark_circle"
            android:src="@drawable/ic_bookmark_outline"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:id="@+id/qtyStepper"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="-14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_qty_stepper"
            android:paddingHorizontal="4dp"
            android:elevation="3dp">

            <ImageView
                android:id="@+id/btnDecrease"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="5dp"
                android:src="@drawable/ic_remove"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/itemQuantity"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnIncrease"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="5dp"
                android:src="@drawable/ic_add"
                app:tint="@color/white" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="-14dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:backgroundTint="@color/surface"
            android:textColor="@color/anydrop_primary"
            android:textSize="12sp"
            android:text="@string/btn_add_to_cart"
            android:elevation="3dp"
            app:cornerRadius="8dp" />

    </FrameLayout>

</LinearLayout>
