<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer square outline (unchanged from before) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="2dp" />
            <stroke android:width="1.2dp" android:color="@color/veg_green" />
        </shape>
    </item>
    <!-- Inner filled dot — the piece bug 1.4 was missing, matches the
         standard Zomato/Swiggy veg symbol (green square + green dot) -->
    <item android:gravity="center" android:width="6dp" android:height="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/veg_green" />
        </shape>
    </item>
</layer-list>
