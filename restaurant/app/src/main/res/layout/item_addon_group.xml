<?xml version="1.0" encoding="utf-8"?>
<!--
    Add-on group card (§1, today.md 2026-08-28). AddonGroupsActivity's
    RecyclerView row. Addon rows inside the group are NOT a nested
    RecyclerView — groups rarely hold more than a handful of addons, so
    AddonGroupAdapter just inflates item_addon_row.xml into
    [addonsContainer] directly, same "dynamic rows in a plain LinearLayout"
    approach EditProfileActivity.buildDayChips() already uses elsewhere in
    this app, avoiding nested-scrolling-RecyclerView complexity for
    something this small.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/groupName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="Choose Size" />

            <ImageView
                android:id="@+id/btnEditGroup"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/text_secondary"
                android:padding="2dp"
                android:contentDescription="@null"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btnDeleteGroup"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_secondary"
                android:padding="2dp"
                android:contentDescription="@null"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <TextView
            android:id="@+id/groupRulesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11.5sp"
            android:textColor="@color/text_secondary"
            tools:text="Required · Pick 1" />

        <LinearLayout
            android:id="@+id/addonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/btnAddAddonToGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_add_addon"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/anydrop_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
