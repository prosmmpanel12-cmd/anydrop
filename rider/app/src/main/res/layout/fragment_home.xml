<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-nav shell (v24 Part 2) — Home tab. Ported from
     activity_rider_dashboard.xml: everything below that layout's old
     header row (greeting/documents-alert/bell all moved up into
     RiderMainActivity's shared top bar in activity_rider_main.xml) is
     unchanged here — same IDs, same cards, same visuals. Only the
     outer container changed (ScrollView root directly, no host
     Activity-level chrome) since a Fragment's onCreateView returns
     this root straight into RiderMainActivity's navHostContainer. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Online/offline card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/onlineStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="You're offline" />

                <TextView
                    android:id="@+id/onlineStatusSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Go online to start receiving deliveries" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/onlineSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/white"
                app:trackTint="@color/anydrop_green" />

            <ProgressBar
                android:id="@+id/onlineSwitchProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:indeterminateTint="@color/anydrop_green" />
        </LinearLayout>

        <!-- Deep Plan Phase 4 (2026-09-09) — area-wise COD cash-hold
             limit banner. Gone by default; shown by refreshFromServer()
             whenever /rider/me's cod_blocked is true (mirrors exactly
             what lib/dispatch.php's find_eligible_riders() enforces
             server-side — this is a reflection of that block, not a
             separate client-side rule). No new orders are pushed while
             blocked, same as an offline rider — going online again
             still flips is_online, but dispatch.php's own COD-limit
             check keeps such a rider out of the COD candidate pool
             until they deposit and their cod_cash_held drops back
             under the limit. -->
        <LinearLayout
            android:id="@+id/codBlockedBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_banner_warning"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/warning_fg" />

            <TextView
                android:id="@+id/codBlockedBannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="@color/warning_fg"
                android:textSize="13sp"
                tools:text="You've reached your cash hold limit (₹2,000). Deposit your COD cash to receive new orders." />
        </LinearLayout>

        <!-- Current delivery placeholder -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dashboard_current_delivery_heading"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <LinearLayout
            android:id="@+id/noActiveDeliveryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_rounded"
            android:padding="26dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_info"
                android:tint="@color/text_secondary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/dashboard_no_active_delivery"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Incoming offer card -->
        <LinearLayout
            android:id="@+id/offerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_new_delivery"
                    android:textColor="@color/anydrop_green"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <TextView
                    android:id="@+id/offerTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/warning_fg"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="0:38" />
            </LinearLayout>

            <TextView
                android:id="@+id/offerRestaurant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Spice Villa" />

            <TextView
                android:id="@+id/offerDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="2.4 km \u2022 3 items \u2022 COD \u20b9420" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRejectOffer"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/surface_alt"
                    android:text="@string/btn_reject"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcceptOffer"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/anydrop_green"
                    android:text="@string/btn_accept"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active delivery card -->
        <LinearLayout
            android:id="@+id/currentOrderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/currentOrderStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/status_approved_fg"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="RIDER ASSIGNED" />

            <TextView
                android:id="@+id/currentOrderRestaurant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Spice Villa" />

            <TextView
                android:id="@+id/currentOrderAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Deliver to: 12 MG Road, Sector 4" />

            <TextView
                android:id="@+id/currentOrderMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Order #AD1029 \u2022 COD \u20b9420" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewOrderDetail"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="@string/dashboard_view_details"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkPickedUp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/anydrop_green"
                android:text="@string/btn_mark_picked_up"
                android:textAllCaps="false"
                android:textColor="@color/black"
                app:cornerRadius="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkDelivered"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/anydrop_green"
                android:text="@string/btn_mark_delivered"
                android:textAllCaps="false"
                android:textColor="@color/black"
                app:cornerRadius="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Earnings placeholder -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dashboard_today_heading"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <LinearLayout
            android:id="@+id/dashboardEarningsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_rounded"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/dashboardEarningsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_placeholder_amount"
                    android:textColor="@color/anydrop_green"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/dashboard_earnings_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/outline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/dashboardDeliveriesValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_placeholder_count"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/dashboard_deliveries_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
