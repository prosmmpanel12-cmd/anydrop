<?xml version="1.0" encoding="utf-8"?>
<!-- In-menu category tab, styled to match the Home screen's food-category
     row (icon in a circle + name below) instead of a plain text chip —
     same visual language, different data source (restaurant's own menu
     categories, via MenuCategory.imageUrl, instead of FoodCategory). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="6dp"
    android:background="?attr/selectableItemBackgroundBorderless">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tabCard"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeWidth="0dp"
        app:strokeColor="@color/anydrop_primary">

        <ImageView
            android:id="@+id/tabIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:scaleType="centerInside"
            tools:src="@drawable/ic_restaurant" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tabName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        tools:text="Main Course" />

</LinearLayout>
