<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Forced dark (non-DayNight) parent, same reasoning the Restaurant
         app's Light theme uses for its own colors.xml — this app only
         ever defines dark-theme colors, so every Material component
         (dialogs, pickers, etc.) needs to resolve against them
         regardless of the device's system light/dark setting, not
         Material3's own DayNight defaults. -->
    <style name="Theme.AnydropRider" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/anydrop_green</item>
        <item name="colorPrimaryVariant">@color/anydrop_green_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/anydrop_green_deep</item>
        <item name="colorOnPrimaryContainer">@color/anydrop_green</item>
        <item name="colorSecondary">@color/anydrop_green</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AnydropRider.AlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AnydropRider.AlertDialog</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.AnydropRider.Button</item>
        <item name="materialButtonStyle">@style/Widget.AnydropRider.Button</item>
        <item name="materialCardViewStyle">@style/Widget.AnydropRider.Card</item>
    </style>

    <style name="Widget.AnydropRider.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="ShapeAppearance.AnydropRider.Button" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Widget.AnydropRider.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.AnydropRider.Button</item>
        <item name="backgroundTint">@color/anydrop_green</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="ThemeOverlay.AnydropRider.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/anydrop_green</item>
        <item name="colorOutline">@color/outline</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AnydropRider.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.AnydropRider.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AnydropRider.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AnydropRider.Dialog.Button</item>
    </style>

    <style name="ShapeAppearance.AnydropRider.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="TextAppearance.AnydropRider.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AnydropRider.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/anydrop_green</item>
    </style>

    <!-- Single-digit OTP input box — six of these in a row, auto-advancing
         on input. Same interaction as the Restaurant app's OtpVerifyActivity,
         restyled for this app's dark/green surface. -->
    <style name="OtpDigitBox">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:cursorVisible">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
</resources>
