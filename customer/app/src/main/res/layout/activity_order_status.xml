<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/anydrop_primary" />

    <TextView
        android:id="@+id/orderCodeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/etaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- I4 follow-up — shows "Scheduled for 8:30 PM" for a scheduled
         order, hidden entirely for a normal ASAP order. -->
    <TextView
        android:id="@+id/scheduledForText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- I2 — order status stepper (docs/features.md Phase I). Hidden for
         cancelled/rejected orders; see OrderStatusStepperView kdoc. -->
    <com.anydrop.food.ui.orderstatus.OrderStatusStepperView
        android:id="@+id/statusStepper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card_rounded"
        android:padding="16dp" />

    <LinearLayout
        android:id="@+id/riderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card_rounded"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/riderNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/riderMobileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/otpCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_badge_veg"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share this OTP with your rider at delivery"
            android:textColor="@color/veg_green" />

        <TextView
            android:id="@+id/otpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/veg_green" />
    </LinearLayout>

    <!-- Item 25 — Refund card. Populated from GET /orders/{id}'s `refund`
         object (backend/lib/orders.php format_order(), migration 42). Only
         visible when the order actually has a refund row (e.g. it was
         cancelled/rejected after a UPI payment) — hidden entirely otherwise,
         same show/hide convention as riderCard/otpCard above. -->
    <LinearLayout
        android:id="@+id/refundCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_rounded"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/refundStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/refundAmountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/refundReasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/refundMethodText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/refundExpectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/refundReferenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <!-- Simple vertical timeline list — one line per stage the refund
             has actually passed through (timeline entries only exist for
             stages that happened, per format_order()'s array_filter). No
             custom stepper view needed; RecyclerView would be overkill for
             a max-5-row list that changes rarely. -->
        <LinearLayout
            android:id="@+id/refundTimelineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelOrder"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="10dp"
        android:text="@string/btn_cancel_order"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="@color/anydrop_primary"
        android:text="@string/btn_back_to_home"
        app:cornerRadius="12dp" />

</LinearLayout>
