<?xml version="1.0" encoding="utf-8"?>
<!-- Illustrated logout-confirmation dialog (2026-08-19 illustration
     retrofit — matches the app owner's reference mockup's "Logout
     Confirmation Dialog" panel). This is new functionality, not just a
     restyle: AccountFragment.kt's btnLogout previously logged out
     immediately on tap with no confirmation step at all — found while
     looking for the existing dialog to retrofit and there wasn't one.
     Centered MaterialAlertDialogBuilder(.setView(...)), same reasoning
     as dialog_confirm_delete.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/illus_logout"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_logout_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dialog_logout_message"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogoutDialogCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogoutDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/anydrop_primary"
            android:text="@string/dialog_logout_confirm_action" />

    </LinearLayout>

</LinearLayout>
