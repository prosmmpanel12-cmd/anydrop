<?xml version="1.0" encoding="utf-8"?>
<!--
    item 26 §D.15 — one row in the Wallet screen's transaction history.
    Same CardView-row shape as item_notification.xml (surface card,
    icon + two-line text block) rather than inventing a new pattern.
    Credit rows show the amount in success_fg with a "+" prefix and an
    up-arrow icon; debit rows show error_fg with a "-" prefix and a
    down-arrow (ic_arrow_up rotated 180°, no separate ic_arrow_down
    drawable exists in this project).
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_notification_icon"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/txnIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_up"
                tools:tint="@color/success_fg" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txnReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="Refund" />

            <TextView
                android:id="@+id/txnNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Order #AD10234" />

            <TextView
                android:id="@+id/txnDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                tools:text="12 Jul, 8:42 PM" />

        </LinearLayout>

        <TextView
            android:id="@+id/txnAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/success_fg"
            tools:text="+₹150.00" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
