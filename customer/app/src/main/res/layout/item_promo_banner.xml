<?xml version="1.0" encoding="utf-8"?>
<!-- One slide of the Home promo carousel (§2.2). Same visual pattern as the
     old static promoBannerContainer it replaces: cover image + dark scrim +
     title/subtitle overlay, bottom-start aligned. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_card_rounded"
        android:clipToOutline="true">

    <ImageView
        android:id="@+id/promoItemImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_card_rounded" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_margin="18dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/promoItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/promoItemSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:alpha="0.95"
            android:textSize="13sp" />

    </LinearLayout>

    </FrameLayout>

</FrameLayout>
