<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Package-visibility declaration (Android 11+) so the app can resolve
         and launch a system speech-recognition activity for the new
         voice-search button (§1.3/§2.8, RecognizerIntent stub). No RECORD_AUDIO
         permission needed here — that's handled by whatever app fulfills this
         intent, not by Anydrop itself. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AnydropCustomer"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <!-- usesCleartextTraffic: needed for local KS Web HTTP backend during
             development (see network/ApiClient.kt). Switch to HTTPS-only once
             the backend moves to InfinityFree, per docs/Status.md next steps. -->

        <!-- Google Maps SDK key — Android-restricted (package name + SHA-1),
             NOT the same key used for backend Geocoding/Directions calls.
             See docs/12_Handover_H6_Map_PinDrop_Photo.md, "API key security"
             section, for why this one is safe to ship in the APK only
             because it's restricted, and why Geocoding/Directions keys must
             never appear here or anywhere else in the app.
             @string/google_maps_key resolves via
             customer/app/src/debug|release/res/values/google_maps_api.xml,
             gitignored, generated from local.properties at build time (see
             that same doc section for the exact gradle wiring — not yet
             added, this meta-data tag is a placeholder until a real
             restricted key exists to put behind it). Build will fail at
             Maps-SDK-init time (not at compile time) until that resource
             actually exists with a real key — expected until billing is
             set up. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <activity
            android:name=".ui.splash.SplashActivity"
            android:theme="@style/Theme.AnydropCustomer.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.restaurant.RestaurantDetailActivity"
            android:exported="true">
            <!-- Bug 3 — per-dish share links (built in
                 ItemDetailBottomSheetFragment.buildShareLink()) open
                 straight here: anydrop://item?rid=<restaurantId>&iid=<itemId>.
                 App-only deep link (no real web domain / Digital Asset
                 Links behind it), same as most food-delivery apps' "open in
                 app" share links — if Anydrop isn't installed, the link just
                 doesn't resolve to anything. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anydrop" android:host="item" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.webview.WebViewActivity"
            android:exported="false" />

        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false" />

        <activity
            android:name=".ui.address.LocationPickerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.address.MapPinDropActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.AddressBookActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.OrderHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.SavedActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.FaqsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.FeedbackActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.orderstatus.OrderStatusActivity"
            android:exported="false" />

    </application>

</manifest>
