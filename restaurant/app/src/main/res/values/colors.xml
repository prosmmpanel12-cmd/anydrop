<resources>
    <!-- Brand — 2026-08-16 palette refresh (docs/restorent/19 §8.1).
         Primary bumped from #E64A19 to #F54F1B ("Exotic Orange", picked
         from the app owner's shared palette set): more saturated/energetic
         than the old shade, still the same warm-orange family so existing
         brand recognition isn't lost, and warm hues are the deliberate
         choice for a food app — they read as appetizing, where blues (the
         other family in that palette set) are well-documented in F&B
         branding as appetite-suppressing and were ruled out for that
         reason, kept only as the new "ink" dark-surface token below. -->
    <color name="anydrop_primary">#F54F1B</color>
    <color name="anydrop_primary_dark">#C93E12</color>
    <color name="anydrop_primary_container">#FFDED2</color>
    <color name="anydrop_secondary">#2E7D32</color>

    <!-- "Ink" — new dark-navy surface token (2026-08-16, docs/restorent/19
         §8.1), used for the top bar + bottom nav (see activity_main.xml)
         instead of plain white. A flat white-background-plus-orange-accent
         app reads as generic/template-y; a dark structural surface behind
         a bright accent is the pattern current restaurant-dashboard and
         delivery-partner apps actually use for visual hierarchy — this
         gives Anydrop's nav chrome the same depth without touching the
         white content surfaces (@color/surface) everything else sits on. -->
    <color name="anydrop_ink">#1E223D</color>
    <color name="anydrop_ink_light">#2A2F52</color>
    <color name="text_on_ink">#FFFFFF</color>
    <color name="text_on_ink_muted">#9AA0C3</color>

    <!-- Surfaces -->
    <color name="background">#FAFAFA</color>
    <color name="surface">#FFFFFF</color>
    <color name="outline">#E0E0E0</color>

    <!-- Text -->
    <color name="text_primary">#1A1A1A</color>
    <color name="text_secondary">#6E6E6E</color>
    <color name="white">#FFFFFF</color>

    <!-- Semantic -->
    <color name="veg_green">#2E7D32</color>
    <color name="nonveg_red">#C62828</color>
    <color name="rating_gold">#F5A623</color>

    <color name="success_bg">#E7F6E9</color>
    <color name="success_fg">#1E7B34</color>
    <color name="error_bg">#FDE9E7</color>
    <color name="error_fg">#C62828</color>
    <color name="info_bg">#E8EEFB</color>
    <color name="info_fg">#2955A8</color>

    <!-- Order status chips -->
    <color name="status_pending_bg">#FFF3E0</color>
    <color name="status_pending_fg">#E65100</color>
    <color name="status_active_bg">#E8EEFB</color>
    <color name="status_active_fg">#2955A8</color>
    <color name="status_done_bg">#E7F6E9</color>
