<?xml version="1.0" encoding="utf-8"?>
<!--
    Add/edit closure dialog (§3, today.md 2026-08-28, doc 60/61). Plain
    MaterialAlertDialogBuilder + this view, same shape as
    dialog_add_addon_group.xml — one form handles both create and edit,
    matching closures-update.php's "full replace, not partial patch"
    design (see that endpoint's kdoc).

    typeToggleGroup switches which of the two field groups below is
    visible — dateRangeFields (start+end date, both real
    MaterialDatePicker-backed, date-only — no time component, matches
    closure_type='date_range' being whole calendar days) vs
    weeklyFields (a single day-of-week Spinner, entries = day_names_full,
    index 0=Monday..6=Sunday to line up with the day_of_week 1..7
    convention restaurants.working_days already uses — see
    ClosureScheduleActivity.kt's day-index conversion). reasonInput
    applies to both types.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <RadioGroup
        android:id="@+id/typeToggleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radioDateRange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/closure_type_date_range" />

        <RadioButton
            android:id="@+id/radioWeeklyRecurring"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/closure_type_weekly_recurring" />

    </RadioGroup>

    <LinearLayout
        android:id="@+id/dateRangeFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/startDateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_calendar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputStartDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_closure_start_date"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/endDateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:startIconDrawable="@drawable/ic_calendar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEndDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_closure_end_date"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/weeklyFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_closure_day_of_week"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/spinnerDayOfWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:entries="@array/day_names_full" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_closure_reason"
            android:inputType="textCapSentences"
            android:maxLength="100" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
