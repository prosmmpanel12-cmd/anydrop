<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="20dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/otpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/otp_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/otpSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="We sent a 6-digit code to rider@example.com"
            xmlns:tools="http://schemas.android.com/tools" />

        <LinearLayout
            android:id="@+id/otpBoxRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <EditText android:id="@+id/otpDigit1" style="@style/OtpDigitBox" />
            <EditText android:id="@+id/otpDigit2" style="@style/OtpDigitBox" />
            <EditText android:id="@+id/otpDigit3" style="@style/OtpDigitBox" />
            <EditText android:id="@+id/otpDigit4" style="@style/OtpDigitBox" />
            <EditText android:id="@+id/otpDigit5" style="@style/OtpDigitBox" />
            <EditText android:id="@+id/otpDigit6" style="@style/OtpDigitBox" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="@color/anydrop_green"
            android:text="@string/btn_verify"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:elevation="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <ProgressBar
            android:id="@+id/otpProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/anydrop_green"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:textColor="@color/anydrop_green"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            tools:text="Resend in 30s"
            xmlns:tools="http://schemas.android.com/tools" />

    </LinearLayout>
</ScrollView>
