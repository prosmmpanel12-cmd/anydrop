<?xml version="1.0" encoding="utf-8"?>
<!-- Fully-rounded ("pill") background for the redesigned Home search bar (§1.3).
     Same solid-surface-color pattern as bg_card_rounded.xml, but with a large
     corner radius (999dp) so it renders as a pill regardless of the bar's height,
     plus a thin outline so it reads as a distinct control against the background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface" />
    <corners android:radius="999dp" />
    <stroke android:width="1dp" android:color="@color/outline" />
</shape>
