<?xml version="1.0" encoding="utf-8"?>
<!-- Restaurant Bank Details submission screen (PENDING.md §15,
     migration 59, docs/63_Handover_2026-08-29_BankDetails_Built.md).
     Header shell copied from activity_edit_profile.xml's top ~55
     lines for consistency with the app's other Account-tab detail
     screens. Status badge card (pending/verified/rejected + optional
     admin remarks) mirrors the 3-state badge added to
     admin/settlements.php the same session backend was built — colors
     set programmatically in BankDetailsActivity.kt since there's no
     single fixed color for a status that can be any of 3 states. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/bank_details_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/btnSaveBankDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="@string/btn_save_bank_details"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Status badge — only shown once a bank_details row exists
                 (i.e. at least one submission has happened). Hidden
                 entirely on a fresh/never-submitted screen, same
                 show/hide-on-null convention as OrderStatusActivity's
                 refundCard in the Customer App. -->
            <LinearLayout
                android:id="@+id/bankStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/bankStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bankAdminRemarksText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Empty-state hint — shown only when nothing has ever been
                 submitted (bankStatusCard above is also gone in that
                 exact case, so these two never show together). -->
            <TextView
                android:id="@+id/bankEmptyStateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/bank_details_empty_state"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/anydrop_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputAccountHolderName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_account_holder_name"
                    android:inputType="textCapWords"
                    android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/anydrop_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputBankName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_bank_name"
                    android:inputType="textCapWords"
                    android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Account number only ever comes back masked from the
                 server (serialize_bank_details_for_restaurant()'s own
                 kdoc: full value never re-echoed after the initial save
                 response) — this field always starts blank, with
                 maskedAccountLabel below showing whatever's currently
                 on file. Leaving this blank on Save means "keep the
                 existing number, only other fields changed" —
                 bank-details-save.php still requires it non-empty
                 today, so BankDetailsActivity.kt must treat "blank +
                 masked value already exists" as its own client-side
                 case (see the Activity's own kdoc). -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/anydrop_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputAccountNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_account_number"
                    android:inputType="number"
                    android:maxLength="18" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/maskedAccountLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/anydrop_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputIfscCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_ifsc_code"
                    android:inputType="textCapCharacters"
                    android:maxLength="11" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/anydrop_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputUpiId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_upi_id"
                    android:inputType="textNoSuggestions"
                    android:maxLength="60" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
