<?xml version="1.0" encoding="utf-8"?>
<!-- Reverted 2026-08-16 (§8.1.1) back to flat @color/anydrop_primary
     (orange) background, matching the app-wide orange+white revert. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/anydrop_primary"
    android:gravity="center">

    <!-- 2026-08-31: was @mipmap/ic_launcher (the legacy fallback icon,
         a near-full-bleed rounded square) rendered at 96dp inside this
         112dp circle backdrop — that square's ~136dp corner-to-corner
         diagonal poked outside the 112dp circle. Switched to
         @mipmap/ic_launcher_round, which (after this session's app-icon
         fix) is a true circle inscribed in its own canvas, so at 96dp
         it sits with a clean 8dp margin inside the 112dp backdrop with
         nothing to poke out. Same fix already in place on the login
         screen, which already used the round variant. -->
    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_splash_logo_circle">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@string/app_name"
            android:visibility="invisible" />

    </FrameLayout>

    <TextView
        android:id="@+id/splashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/splashTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/splash_tagline"
        android:textSize="14sp"
        android:textColor="@color/anydrop_primary_container"
        android:visibility="invisible" />

</LinearLayout>
