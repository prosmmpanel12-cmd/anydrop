# ============================================================
# QrPay — Environment Variables Template
# Copy to `.env` (untracked) or set via your host's env panel.
# NEVER commit a file with real values filled in.
# ============================================================

# ---- Database ----
DB_HOST=
DB_PORT=3306
DB_NAME=qrpay
DB_USER=
DB_PASS=

# ---- Session / security ----
# Random 32+ byte string, e.g.: php -r "echo bin2hex(random_bytes(32));"
SESSION_SECRET=
# Comma-separated list of admin emails allowed into the admin panel (Phase 7)
ADMIN_EMAIL_ALLOWLIST=

# ---- SMTP (OTP emails) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=QrPay
SMTP_ENCRYPTION=tls

# ---- App URL (used to build email verification / password reset links) ----
# No trailing slash, e.g. https://qrpay.example.com
APP_URL=

# ---- OTP settings (2FA login step only) ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_REQUESTS_PER_HOUR=5

# ---- Email verification link settings ----
EMAIL_VERIFY_EXPIRY_MINUTES=60

# ---- Password reset link settings ----
PASSWORD_RESET_EXPIRY_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5

# NOTE: QrPay's own payout UPI ID / MID (used when a developer pays QrPay
# for a plan) is NOT an env var. It lives in the `admin_settings` table
# (singleton row, id=1) and is managed via the admin panel (Phase 7).
# App code always reads it from the DB — never from env — so it can be
# changed without a redeploy. See core/plan_limits.php / db.php.
#
# NOTE: whether email verification is required at signup is ALSO in
# admin_settings (email_verification_enabled), not env — admin-controlled,
# system-wide. Per-user 2FA (developers.two_fa_enabled) lives in the DB
# too, toggled by each developer from their own panel settings.
#
# NOTE: the free plan's daily (10) / monthly (300) credit limits are NOT
# env vars either — they're columns on the 'free' row in the `plans`
# table (daily_credit_limit, payment_limit), editable by the admin like
# any other plan.
