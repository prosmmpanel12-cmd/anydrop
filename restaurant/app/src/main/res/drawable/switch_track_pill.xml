<?xml version="1.0" encoding="utf-8"?>
<!-- Custom SwitchMaterial track (2026-08-19 toggle redesign — app-owner
     reference: a fully-filled rounded pill in both states, not the thin
     Material line-track, colored orange when ON and light grey when OFF
     rather than the old green/red scheme. Paired with switch_thumb_pill.xml
     (a big white circle) via app:track/app:thumb on
     Widget.AnydropRestaurant.Switch — every SwitchMaterial in the app uses
     that one style now, so this single pair of drawables drives all of
     them. Fixed intrinsic size (52dp x 30dp) so the pill always renders
     at the same size regardless of where it's used. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/anydrop_primary" />
            <corners android:radius="15dp" />
            <size
                android:width="52dp"
                android:height="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/switch_track_off" />
            <corners android:radius="15dp" />
            <size
                android:width="52dp"
                android:height="30dp" />
        </shape>
    </item>
</selector>
