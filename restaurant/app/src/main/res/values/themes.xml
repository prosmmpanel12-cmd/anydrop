<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AnydropRestaurant" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/anydrop_primary</item>
        <item name="colorPrimaryVariant">@color/anydrop_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/anydrop_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- 2026-08-16 palette refresh (docs/restorent/19 §8.1) — status bar
             now matches the new dark "ink" top bar in activity_main.xml
             instead of the flat orange bar the old design used. -->
        <item name="android:statusBarColor">@color/anydrop_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Single-digit OTP input box (ui/signup/OtpVerifyActivity) — six of these
         in a row, auto-advancing on input, same visual language as
         bg_card_rounded used everywhere else in this app for input fields. -->
    <style name="OtpDigitBox">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_card_rounded</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:cursorVisible">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
</resources>
