<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors item_menu_category.xml's card shell: a title bar standing in
     for the category name, then 3 skeleton_menu_item_row rows standing
     in for that category's food items (docs/restorent/19, §9.2's "2
     skeleton category cards, each with a gray title bar + 3 skeleton
     item rows"). Wrap in ShimmerFrameLayout at the call site. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="12dp"
    android:padding="12dp">

    <!-- category title bar -->
    <View
        android:layout_width="120dp"
        android:layout_height="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_skeleton_bar" />

    <include layout="@layout/skeleton_menu_item_row" />
    <include layout="@layout/skeleton_menu_item_row" />
    <include layout="@layout/skeleton_menu_item_row" />

</LinearLayout>
