<?xml version="1.0" encoding="utf-8"?>
<!-- UI polish pass, 2026-09-11 (app-owner ask: "rider ke dialogs sahi
     karo... just like restaurant app") — restyled to match
     restaurant/dialog_logout_confirm.xml's shape: circular icon badge,
     centered title, centered subtitle, full-width custom buttons (no
     more default AlertDialog title bar / OS-style text buttons).
     Content built around a single manual-entry field: rider is typing a
     code the restaurant staff reads aloud when handing over the order
     (migration 83, 2026-09-11 — new pickup OTP, mirrors the existing
     delivery OTP dialog's shape one-for-one). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            app:tint="@color/anydrop_green"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pickup_otp_dialog_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/pickup_otp_dialog_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/anydrop_green"
        app:hintTextColor="@color/anydrop_green"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputPickupOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_pickup_otp"
            android:textColor="@color/text_primary"
            android:inputType="number"
            android:maxLength="6"
            android:letterSpacing="0.3"
            android:gravity="center"
            android:textSize="18sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/pickupOtpError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/error_fg"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        tools:text="Incorrect code — 2 attempts remaining" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickupOtpCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickupOtpConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/anydrop_green"
            android:text="@string/btn_mark_picked_up_confirm" />

    </LinearLayout>

</LinearLayout>
