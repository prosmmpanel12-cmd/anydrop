<?xml version="1.0" encoding="utf-8"?>
<!-- Staggered entrance for login/signup form fields — same shape as
     splash_text_in.xml, but the startOffset is set per-view in code
     (setStartOffset) so each field cascades in after the one above it,
     Zomato/Swiggy-style rather than everything popping in at once. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <translate
        android:fromYDelta="18dp"
        android:toYDelta="0dp"
        android:duration="380"
        android:fillAfter="true" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="380"
        android:fillAfter="true" />
</set>
