<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AnydropRestaurant" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/anydrop_primary</item>
        <item name="colorPrimaryVariant">@color/anydrop_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/anydrop_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- Reverted 2026-08-16 (§8.1.1) back to the flat orange status bar,
             matching activity_main.xml's top-bar revert. -->
        <item name="android:statusBarColor">@color/anydrop_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Pill-shaped ON/OFF toggle (doc 22 item 4, app-owner ask
         2026-08-18: "make the toggle attractive, your call on style").
         Used as the two children of a MaterialButtonToggleGroup (single
         selection) — item_coupon_manage_row.xml's is_active toggle and
         dialog_add_coupon.xml's is_public toggle both reuse this same
         style so the whole coupon screen has one consistent toggle
         language rather than a different control per flag. Selected/
         unselected coloring comes from MaterialButtonToggleGroup's own
         checked-state handling against colorPrimary — no manual
         state-list drawable needed. -->
    <style name="ToggleButton.Pill" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/anydrop_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">16dp</item>
    </style>

    <!-- Phase 4 (UI/UX overhaul, on/off toggle redesign, 2026-08-19):
         top-bar restaurant OPEN/CLOSED status toggle. Extends the same
         ToggleButton.Pill base the coupon screen's is_active/is_public
         toggles already use (doc 22 item 4), for one consistent pill-
         toggle language across the app, rather than the old plain
         clickable dot+text pill this replaces. Two differences from the
         base style, on purpose: (1) per-button semantic color (green for
         Open, red for Closed) instead of the shared brand-orange
         selected-state color, since this control's whole job is to
         signal a red/green state at a glance; (2) slightly larger
         (44dp vs. 36dp min height, 13sp vs. 12sp text) since this is the
         one always-visible top-bar control every tab shares, not a
         secondary row action. -->
    <style name="ToggleButton.Pill.StatusOpen" parent="ToggleButton.Pill">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="iconSize">18dp</item>
        <item name="strokeColor">@color/toggle_open_stroke_color</item>
        <item name="android:textColor">@color/toggle_open_content_color</item>
        <item name="iconTint">@color/toggle_open_content_color</item>
        <item name="backgroundTint">@color/toggle_open_bg_color</item>
    </style>

    <style name="ToggleButton.Pill.StatusClosed" parent="ToggleButton.Pill">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="iconSize">18dp</item>
        <item name="strokeColor">@color/toggle_closed_stroke_color</item>
        <item name="android:textColor">@color/toggle_closed_content_color</item>
        <item name="iconTint">@color/toggle_closed_content_color</item>
        <item name="backgroundTint">@color/toggle_closed_bg_color</item>
    </style>

    <!-- Single-digit OTP input box (ui/signup/OtpVerifyActivity) — six of these
         in a row, auto-advancing on input, same visual language as
         bg_card_rounded used everywhere else in this app for input fields. -->
    <style name="OtpDigitBox">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_card_rounded</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:cursorVisible">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
</resources>
