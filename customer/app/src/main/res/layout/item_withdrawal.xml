<?xml version="1.0" encoding="utf-8"?>
<!--
    PENDING.md §37 — one row in WithdrawActivity's history list. Same
    CardView-row shape as item_wallet_transaction.xml (surface card,
    two-line text block + trailing value), status shown as a colored
    label instead of a credit/debit icon since a withdrawal only ever
    moves money one direction (out).
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/withdrawalAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="₹250.00" />

            <TextView
                android:id="@+id/withdrawalMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                tools:text="Bank transfer" />

            <TextView
                android:id="@+id/withdrawalDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                tools:text="12 Jul, 8:42 PM" />

            <TextView
                android:id="@+id/withdrawalRejectReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/error_fg"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Reason: Invalid account details" />

        </LinearLayout>

        <TextView
            android:id="@+id/withdrawalStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_status_pill"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            tools:text="Requested" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
