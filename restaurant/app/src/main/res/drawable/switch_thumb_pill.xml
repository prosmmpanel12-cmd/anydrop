<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-08-31: enlarged 16dp -> 20dp to match switch_track_pill.xml's
     bigger 46x26dp track, plus a thin outline border so the white thumb
     still reads as a distinct disc even against a light background
     behind the switch, not just a soft blur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/switch_thumb_color" />
    <stroke android:width="0.5dp" android:color="@color/outline" />
    <size
        android:width="20dp"
        android:height="20dp" />
</shape>
