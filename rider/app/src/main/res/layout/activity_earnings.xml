<?xml version="1.0" encoding="utf-8"?>
<!--
    EarningsActivity — reached by tapping the dashboard's TODAY earnings
    card (deep-plan §19-20, doc 90's "natural next slice" note). Full
    ledger (rider_earnings_ledger.php's `recent` array, up to 20 rows —
    no pagination yet, see that endpoint's own kdoc) plus the same
    today/balance figures the dashboard card already shows, so this
    screen doesn't feel disconnected from where it was launched.

    No shared Toolbar/AppBar convention exists yet anywhere in this
    rider app (checked: ApplicationStatusActivity and
    RiderDashboardActivity both use a plain top LinearLayout header
    or none at all) — this screen's header row (back arrow + title)
    is a new, minimal pattern, not a deviation from an existing one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/earnings_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card_rounded"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/earningsTodayValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_placeholder_amount"
                android:textColor="@color/anydrop_green"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/earnings_today_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/outline" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/earningsBalanceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_placeholder_amount"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/earnings_balance_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Deep-plan §17-18 — COD cash-held card. Deliberately its own card
         below the earnings summary, not merged into it: §17's own
         wording is "display the running cash-held amount SEPARATELY
         from earnings" — this is money the rider owes the platform,
         the opposite direction from the today/balance figures above,
         so keeping it visually distinct avoids reading as a third
         earnings number. Bar + label re-tint red/amber/green in code
         (EarningsActivity.renderCodCard()) depending on how close
         codCashHeld is to codSettlementLimit — layout only sets the
         neutral/default look here. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_rounded"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cod_cash_held_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/codCashHeldPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/status_approved_bg"
                android:textColor="@color/status_approved_fg"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="OK" />

        </LinearLayout>

        <TextView
            android:id="@+id/codCashHeldValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dashboard_placeholder_amount"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="₹850" />

        <ProgressBar
            android:id="@+id/codCashHeldBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/status_approved_fg"
            android:progressBackgroundTint="@color/outline" />

        <TextView
            android:id="@+id/codCashHeldLimitNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="Limit ₹2000 — settle with admin once you reach this to keep receiving COD orders." />

    </LinearLayout>

    <!-- share_percent context line — read from the same endpoint, shown
         once beneath the summary card rather than repeated per-row,
         since it's a platform-wide rate, not a per-entry value. -->
    <TextView
        android:id="@+id/earningsShareNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="You earn 80% of each delivery fee" />

    <!-- Deep-plan §21, migration 74 — opens RequestPayoutActivity. Placed
         below the share-percent note and above "RECENT ACTIVITY", same
         position the handover spec called for so it reads as this
         screen's one actionable button, not mixed into the read-only
         ledger section below it. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRequestPayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/earnings_request_payout_button" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/earnings_recent_heading"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/earningsSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/earningsLedgerList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/earningsEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/earnings_empty"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
