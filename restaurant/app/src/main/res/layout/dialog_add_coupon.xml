<?xml version="1.0" encoding="utf-8"?>
<!-- Add/Edit Coupon dialog (doc 07 §2.1; usage-limit fields + edit reuse
     added in the coupon-system follow-up session). Plain TextInputLayout
     fields, same visual pattern as dialog_add_menu_item.xml. Discount
     type uses a 2-option ChipGroup (single-choice) rather than a Spinner
     — matches this app's existing chip pattern elsewhere (working-days
     chips in activity_edit_profile.xml) instead of introducing a new
     widget type.

     Shared by both CouponManagerActivity.showAddCouponDialog() and
     showEditCouponDialog() — the edit path pre-fills every field except
     inputCode (code is create-only, see coupons-update.php's kdoc) and
     hides discountTypeGroup entirely (discount_type is also create-only;
     the edit dialog just shows the existing type as plain label text via
     editDiscountTypeLabel instead of a chip picker, so the field a user
     literally cannot change isn't presented as an editable control). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_tag"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/coupon_hint_code"
                android:inputType="textCapCharacters"
                android:maxLength="20" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Edit-mode only: discount_type is create-only (server rejects
             changing it), so instead of a picker the edit dialog shows
             this plain label ("Flat" / "Percent") for context. Gone in
             add-mode; discountTypeGroup below is gone in edit-mode. -->
        <TextView
            android:id="@+id/editDiscountTypeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            tools:text="Discount type: Flat (can't be changed after creation)" />

        <TextView
            android:id="@+id/discountTypeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/coupon_hint_discount_type"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/discountTypeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFlat"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ Flat"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPercent"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="% Percent" />

        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:startIconDrawable="@drawable/ic_percent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDiscountValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/coupon_hint_discount_value"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputMinOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/coupon_hint_min_order"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/maxDiscountLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputMaxDiscount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/coupon_hint_max_discount"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- doc 22 item 5 — real date+time picker instead of manual
             yyyy-MM-dd typing. android:focusable="false" +
             android:clickable="true" turns this into a tap target that
             opens MaterialDatePicker → MaterialTimePicker (chained,
             CouponManagerActivity.showValidUntilPicker()) rather than a
             text field with a soft-keyboard date hint that never opened
             a picker UI. The field displays a friendly formatted string;
             the actual "yyyy-MM-dd HH:mm:ss" value sent to the server is
             stashed in the view's tag (see submitNewCoupon()/
             submitCouponEdit()) so display formatting never has to be
             re-parsed back into the wire format. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/validUntilLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:startIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_close">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputValidUntil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/coupon_hint_valid_until"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- doc 22 item 3 — "show on coupon screen" (is_public) toggle,
             now at creation time (previously not exposed in any UI at
             all) AND editable from the edit dialog too, per the
             follow-up answer ("Both create and edit"). Same pill-toggle
             style as the row's is_active control (item 4) for visual
             consistency across the two flags. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_secondary"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coupon_public_toggle_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/coupon_public_toggle_hint"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePublicGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPublicOn"
                    style="@style/ToggleButton.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coupon_toggle_on" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPublicOff"
                    style="@style/ToggleButton.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coupon_toggle_off" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

        <!-- usage_limit_total / usage_limit_per_user — coupons-create.php
             and CouponCreateBody/CouponUpdateBody already supported both;
             only this dialog was missing them (00_Status.md, coupon
             session backlog item 3). Both optional — null/blank means
             "unlimited", matching the backend's own null-is-unlimited
             convention (coupons-update.php only writes the field when the
             key is present in the body at all, and coupons-create.php
             leaves the column NULL when omitted). -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputUsageLimitTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/coupon_hint_usage_limit_total"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputUsageLimitPerUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/coupon_hint_usage_limit_per_user"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</ScrollView>
